{
  "functions": {
    "api/ping.js": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 0 */3 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
